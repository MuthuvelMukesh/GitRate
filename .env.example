# ===== Environment Configuration =====
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# ===== Database Configuration =====
DATABASE_URL=postgresql+asyncpg://gitrate:gitrate_dev_password@localhost:5432/gitrate_audit
DB_ECHO=False
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ===== Redis Configuration =====
REDIS_URL=redis://:gitrate_dev_password@localhost:6379/0
REDIS_CACHE_TTL=86400

# ===== Security =====
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== CORS Configuration =====
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# ===== GitHub Integration =====
GITHUB_TOKEN=your_github_token_here
GITHUB_API_BASE_URL=https://api.github.com

# ===== AI/LLM Configuration =====
# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4-turbo-preview

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-pro

# LiteLLM Configuration
LITELLM_LOG=True
LITELLM_CACHE=True

# ===== CVE Database =====
NVD_API_KEY=your_nvd_api_key_optional
SNYK_API_KEY=your_snyk_api_key

# ===== Email Configuration =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
SMTP_FROM_EMAIL=noreply@gitrate.io
SMTP_FROM_NAME=GitRate

# ===== AWS Configuration (for production) =====
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=gitrate-reports
AWS_S3_REPORTS_PREFIX=audit-reports/

# ===== Sentry Configuration (Error Tracking) =====
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# ===== Monitoring =====
PROMETHEUS_PORT=9090
GRAFANA_PASSWORD=admin

# ===== Celery Configuration =====
CELERY_BROKER_URL=redis://:gitrate_dev_password@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:gitrate_dev_password@localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json

# ===== API Rate Limiting =====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_DAY=1000

# ===== Frontend Configuration =====
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=GitRate Acquisition Audit
NEXT_PUBLIC_APP_VERSION=1.0.0

# ===== Feature Flags =====
ENABLE_PLAGIARISM_DETECTION=true
ENABLE_ONBOARDING_ESTIMATION=true
ENABLE_SCALABILITY_ANALYSIS=true
ENABLE_90DAY_ROADMAP=true

# ===== Audit Configuration =====
AUDIT_TIMEOUT_SECONDS=300
MAX_REPO_SIZE_MB=500
CACHE_AUDIT_RESULTS=true
