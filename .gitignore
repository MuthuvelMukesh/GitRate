# .gitignore for GitRate

# Environment variables
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
ENV/
env/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.iml

# Testing
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.hypothesis/

# Node (Frontend)
gitrate-ui/node_modules/
gitrate-ui/.next/
gitrate-ui/out/
gitrate-ui/dist/

# Docker
.dockerignore

# Reports & Artifacts
reports/
*.pdf
*.xlsx
*.csv

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
temp/
tmp/
*.tmp
*.bak

# OS
Thumbs.db
.DS_Store
*.swp

# Database
*.db
*.sqlite
*.sqlite3

# Cache
.cache/
.mypy_cache/
.pylint_cache/

# Pre-commit
.pre-commit-config.yaml
.pre-commit-config-local.yaml

# Secrets (be careful!)
.env.production
secrets/
*.key
*.pem
